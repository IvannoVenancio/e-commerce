
<body>
  <div class="orders-container">
    <table class="orders-table">
      <thead>
        <tr>
          <th>Número do Pedido</th>
          <th>Nome do Cliente</th>
          <th>Data do Pedido</th>
          <th>Status</th>
          <th>Total (AOA)</th>
        </tr>
      </thead>
      <tbody>
           {{#each order}} 
       <tr>
            <td> {{Id}} </td>
            <td>{{userId}}</td>
            <td>{{createdAt}}</td>
            <td> {{status}}</td>
            <td> {{Total}} </td>
        </tr>
        {{/each order}}
      </tbody>
    </table>
  </div>

 
